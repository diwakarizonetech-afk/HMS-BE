# ==========================================
# Hospital Management System - .gitignore
# ==========================================

# ------------------------------------------
# Node.js & Frontend (Vite / React / TS)
# ------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Bundles
dist/
**/dist/
dist-ssr/
build/
**/build/
.vite/
**/.vite/
*.local

# ------------------------------------------
# Python & Backend (FastAPI / SQLAlchemy)
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
**/venv/
**/env/
**/.venv/

# Alembic Cache & DB Temp Files
alembic/versions/__pycache__/
*.sqlite
*.sqlite3
*.db
*.log

# ------------------------------------------
# Testing & Code Quality
# ------------------------------------------
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
htmlcov/
.nox/
.hypothesis/

# ------------------------------------------
# Environment Variables & Credentials
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example
!**/env.example
!**/.env.example

# ------------------------------------------
# IDEs, Editors & AI Workspace Caches
# ------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-workspace
.gemini/
.brain/
.agents/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
