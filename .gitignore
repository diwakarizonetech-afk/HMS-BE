# ==========================================
# Hospital Management System - .gitignore
# ==========================================

# ------------------------------------------
# Node.js & Frontend (Vite / React / TS)
# ------------------------------------------
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Build Outputs & Bundles
dist/
**/dist/
dist-ssr/
build/
**/build/
.vite/
**/.vite/
*.local

# ------------------------------------------
# Python & Backend (FastAPI / SQLAlchemy)
# ------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
env/
venv/
ENV/
env.bak/
venv.bak/
.venv/
**/venv/
**/env/
**/env.bak/
**/.venv/

# Alembic Cache & DB Files
alembic/versions/__pycache__/
**/alembic/versions/__pycache__/
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
logs/
**/logs/

# ------------------------------------------
# Testing, Coverage & Code Quality
# ------------------------------------------
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/
**/.nox/
.hypothesis/
test-results/
coverage/

# ------------------------------------------
# Environment Variables & Certificates
# ------------------------------------------
.env
.env.*
!.env.example
!**/env.example
!**/.env.example
*.pem
*.key
*.cert
*.crt

# ------------------------------------------
# IDEs, Editors & AI Workspace Caches
# ------------------------------------------
.vscode/
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.orig
*.sublime-workspace
.gemini/
.brain/
.agents/
.cursor/
.antigravity/

# ------------------------------------------
# Operating System Files
# ------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
